# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead —
# .env.local is gitignored and never gets deployed.

# Password for /admin-console. Change this from any value used in development.
ADMIN_CONSOLE_PASSWORD=

# Secret used to sign the admin session cookie. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# REDCap API for the /redcap-request form. Create a token in the "Howard University
# RCMI Research Support Portal" project (API → request token; needs API Import rights).
# Without these, submissions are only logged in development and refused in production.
REDCAP_API_URL=
REDCAP_API_TOKEN=
# Record ID field of that project (defaults to name_id).
REDCAP_RECORD_ID_FIELD=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) for /redcap-request.
# Create keys at https://www.google.com/recaptcha/admin (type: v2 Checkbox) and add
# your domains plus "localhost". Without them a plain checkbox is shown instead.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
