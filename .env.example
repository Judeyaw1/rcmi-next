# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead —
# .env.local is gitignored and never gets deployed.

# Password for /admin-console. Change this from any value used in development.
ADMIN_CONSOLE_PASSWORD=

# Secret used to sign the admin session cookie. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
